---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { Image } from 'astro:assets';
import logoSrc from '../assets/home/titulo-header.png';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const hrefFor = (base: string) =>
	`/${lang === 'en' ? '' : lang + '/'}${base}`.replace(/\/\//g, '/');

const navLinks = [
	{ key: 'nav.tattoos', href: hrefFor('tattoos') },
	{ key: 'nav.works', href: hrefFor('works') },
	{ key: 'nav.ceramics', href: hrefFor('ceramics') },
	{ key: 'nav.murals', href: hrefFor('murals') },
];

const aboutLinks = [
	{ key: 'nav.biography', href: hrefFor('biography') },
	{ key: 'nav.faqs', href: hrefFor('faqs') },
	{ key: 'nav.contact', href: hrefFor('contact') },
];

const socials = [
	{
		name: 'Instagram',
		href: 'https://instagram.com/nikipepperstattoo',
		icon: `<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>`,
	},
	{
		name: 'Facebook',
		href: 'https://facebook.com/niki.teper',
		icon: `<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>`,
	},
];
---

<footer class="bg-neutral-950 text-neutral-300 mt-20">
	<!-- CTA Banner -->
	<div class="bg-green-500 py-12 px-4">
		<div class="max-w-4xl mx-auto text-center">
			<h2 class="text-2xl md:text-3xl font-serif font-bold text-white mb-3">
				{t('footer.ctaTitle')}
			</h2>
			<p class="text-green-50 text-base md:text-lg mb-6 max-w-2xl mx-auto">
				{t('footer.ctaDescription')}
			</p>
			<a
				href={hrefFor('contact')}
				class="inline-block px-8 py-3 bg-white text-green-600 font-semibold rounded-full hover:bg-green-50 hover:scale-105 transition-all duration-300 shadow-lg"
			>
				{t('footer.ctaButton')}
			</a>
		</div>
	</div>

	<!-- Main Footer -->
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">

			<!-- Column 1: Brand -->
			<div class="lg:col-span-1">
				<a href={`/${lang === 'en' ? '' : lang + '/'}`} class="inline-block mb-4">
					<Image
						src={logoSrc}
						alt="Niki Peppers"
						class="h-14 w-auto footer-logo"
					/>
				</a>
				<p class="text-neutral-400 text-sm leading-relaxed mb-6">
					{t('footer.aboutFooter')}
				</p>
				<!-- Social Icons -->
				<div class="flex gap-3">
					{socials.map((s) => (
						<a
							href={s.href}
							target="_blank"
							rel="noopener noreferrer"
							aria-label={s.name}
							class="group flex items-center justify-center w-10 h-10 rounded-full bg-neutral-800 text-neutral-400 hover:bg-green-500 hover:text-white transition-all duration-300 hover:scale-110"
						>
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
								<Fragment set:html={s.icon} />
							</svg>
						</a>
					))}
				</div>
			</div>

			<!-- Column 2: Explore -->
			<div>
				<h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">
					{t('footer.explore')}
				</h3>
				<ul class="space-y-3">
					{navLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-neutral-400 hover:text-green-400 transition-colors duration-200 text-sm flex items-center gap-2 group"
							>
								<span class="w-0 group-hover:w-3 h-px bg-green-400 transition-all duration-300"></span>
								{t(link.key)}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Column 3: About -->
			<div>
				<h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">
					{t('footer.links')}
				</h3>
				<ul class="space-y-3">
					{aboutLinks.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-neutral-400 hover:text-green-400 transition-colors duration-200 text-sm flex items-center gap-2 group"
							>
								<span class="w-0 group-hover:w-3 h-px bg-green-400 transition-all duration-300"></span>
								{t(link.key)}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Column 4: Connect -->
			<div>
				<h3 class="text-white font-semibold text-sm uppercase tracking-wider mb-5">
					{t('footer.connect')}
				</h3>
				<ul class="space-y-4">
					<li>
						<a
							href="mailto:nikipepperstattoo@gmail.com"
							class="text-neutral-400 hover:text-green-400 transition-colors duration-200 text-sm flex items-start gap-3"
						>
							<svg class="w-5 h-5 mt-0.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
								<path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
							</svg>
							<span>nikipepperstattoo<wbr />@gmail.com</span>
						</a>
					</li>
					<li class="flex items-start gap-3 text-sm text-neutral-400">
						<svg class="w-5 h-5 mt-0.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
							<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
						</svg>
						<span>{t('footer.location')}</span>
					</li>
					<li class="flex items-start gap-3 text-sm text-neutral-400">
						<svg class="w-5 h-5 mt-0.5 shrink-0 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
							<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
						</svg>
						<span>{lang === 'es' ? 'Lun — Vie · 10 a 18 hs' : 'Mon — Fri · 10 AM to 6 PM'}</span>
					</li>
				</ul>
			</div>
		</div>
	</div>

	<!-- Bottom Bar -->
	<div class="border-t border-neutral-800">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
			<p class="text-neutral-500 text-xs">
				&copy; {new Date().getFullYear()} Niki Peppers. {t('footer.rights')}
			</p>
			<p class="text-neutral-600 text-xs flex items-center gap-1">
				{t('footer.madeWith')}
				<svg class="w-3.5 h-3.5 text-green-500 animate-pulse" fill="currentColor" viewBox="0 0 24 24">
					<path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
				</svg>
				{t('footer.by')}
			</p>
		</div>
	</div>
</footer>
