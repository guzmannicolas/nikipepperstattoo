---
export interface Button {
  label: string;
  value: string;
  class?: string;
  active?: boolean;
}

const { buttons = [] as Button[] } = Astro.props;
---
<div class="flex flex-wrap justify-center gap-4 mb-12">
  {buttons.map((b: Button, i: number) => (
    <button class="filter-btn px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-black text-black font-semibold transition-all" data-filter={b.value} data-value={b.value}>
      {b.label}
    </button>
  ))}
</div>
