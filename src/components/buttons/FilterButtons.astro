---
export interface Button {
  label: string;
  value: string;
  class?: string;
  active?: boolean;
}

const { buttons = [] as Button[] } = Astro.props;
---

<div class="flex items-center gap-2 mb-12 filter-carousel">
  <!-- left arrow (mobile only) — hidden until user scrolls right -->
  <button
    type="button"
    class="filter-prev md:hidden flex-shrink-0 w-9 h-9 rounded-full bg-white border border-neutral-200 items-center justify-center shadow-md text-neutral-800 hidden"
    aria-label="Anterior filtros"
  >&lt;</button>

  <div
    class="filter-scroll js-filter-scroll flex gap-3 py-2 overflow-x-auto md:overflow-visible md:flex-wrap md:justify-center no-scrollbar min-w-0 flex-1"
    role="tablist"
    aria-label="Filtros"
  >
    {
      buttons.map((b: Button, i: number) => (
        <button
          type="button"
          role="tab"
          class="flex-shrink-0 filter-btn series-filter snap-start px-6 py-2 rounded-full font-semibold transition-all border-2 bg-white border-neutral-200 text-black hover:border-green-400 aria-[pressed=true]:bg-green-500 aria-[pressed=true]:text-white aria-[pressed=true]:border-transparent"
          data-filter={b.value}
          data-value={b.value}
          aria-pressed={b.active ? "true" : "false"}
        >
          {b.label}
        </button>
      ))
    }
  </div>

  <!-- right arrow (mobile only) -->
  <button
    type="button"
    class="filter-next md:hidden flex-shrink-0 w-9 h-9 rounded-full bg-white border border-neutral-200 items-center justify-center shadow-md text-neutral-800 flex"
    aria-label="Siguiente filtros"
  >&gt;</button>
</div>

<style>
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  .js-filter-scroll { scroll-snap-type: x mandatory; scroll-behavior: smooth; }
  @media (min-width: 768px) {
    .js-filter-scroll { scroll-snap-type: none; }
    .filter-prev, .filter-next { display: none; }
  }
</style>

<script>
;(function () {
  // make initialization per-wrapper and idempotent
  const wrappers = document.querySelectorAll('.filter-carousel');
  wrappers.forEach((wrap) => {
    const wrapper = wrap as HTMLElement;
    if (wrapper.dataset.fbInit) return;
    wrapper.dataset.fbInit = '1';

    const scroller = wrapper.querySelector<HTMLElement>('.js-filter-scroll');
    const prev = wrap.querySelector<HTMLElement>('.filter-prev');
    const next = wrap.querySelector<HTMLElement>('.filter-next');
    if (!scroller) return;

    const update = () => {
      if (!prev || !next) return;
      prev.style.display = scroller.scrollLeft > 2 ? 'flex' : 'none';
      next.style.display = scroller.scrollLeft + scroller.clientWidth < scroller.scrollWidth - 2 ? 'flex' : 'none';
    };

    const amount = () => Math.min(Math.round(scroller.clientWidth * 0.7), 360);

    prev?.addEventListener('click', (e) => {
      e.preventDefault();
      scroller.scrollBy({ left: -amount(), behavior: 'smooth' });
    });
    next?.addEventListener('click', (e) => {
      e.preventDefault();
      scroller.scrollBy({ left: amount(), behavior: 'smooth' });
    });

    scroller.addEventListener('scroll', update, { passive: true });
    // initial
    update();

    // recompute on resize
    let t: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(update, 120);
    });
  });
})();
</script>
