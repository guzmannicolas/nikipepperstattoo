---
import { getLangFromUrl, useTranslations, languages } from "../i18n/utils";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Get current path without language prefix
const currentPath =
	Astro.url.pathname.replace(`/${lang}`, "").replace("/es", "") || "/";

// Helpers to compute hrefs and active state (compare against path without lang)
const stripPath = (p: string) => (p || "/").replace(/\/+$|\/+$/g, "");
const stripped = currentPath || "/";

const hrefFor = (base: string) => {
	if (!base) return `/${lang === "en" ? "" : lang + "/"}`;
	return `/${lang === "en" ? "" : lang + "/"}${base}`.replace(/\/\//g, "/");
};

const isActive = (base: string) => {
	if (!base) return stripped === "/" || stripped === "";
	const b = base.startsWith("/") ? base : `/${base}`;
	return stripped === b || stripped.startsWith(b + "/");
};
---

<nav id="navbar" class="fixed w-full z-50 transition-all duration-300">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<a
				href={`/${lang === "en" ? "" : lang + "/"}`}
				class="relative z-10"
			>
				<img id="navbar-logo" src="/titulo-header.png" alt="Niki Peppers" class="h-20 w-auto" />
			</a>
			<div id="nav-links" class="hidden md:flex space-x-6 items-center font-bold">
				<a href={hrefFor('tattoos')} class={ `nav-link text-black relative ${isActive('tattoos') ? 'text-green-500' : ''}` }>{t("nav.tattoos")}</a>
				<a href={hrefFor('works')} class={ `nav-link text-black relative ${isActive('works') ? 'text-green-500' : ''}` }>{t("nav.works")}</a>
				<a href={hrefFor('ceramics')} class={ `nav-link text-black relative ${isActive('ceramics') ? 'text-green-500' : ''}` }>{t("nav.ceramics")}</a>
				<a href={hrefFor('murals')} class={ `nav-link text-black relative ${isActive('murals') ? 'text-green-500' : ''}` }>{t("nav.murals")}</a>
				<a href={hrefFor('biography')} class={ `nav-link text-black relative ${isActive('biography') ? 'text-green-500' : ''}` }>{t("nav.biography")}</a>
				<a href={hrefFor('faqs')} class={ `nav-link text-black relative ${isActive('faqs') ? 'text-green-500' : ''}` }>{t("nav.faqs")}</a>
				<a href={hrefFor('contact')} class={ `nav-link text-black relative ${isActive('contact') ? 'text-green-500' : ''}` }>{t("nav.contact")}</a>


				<!-- Language Switcher -->
				<div
					id="lang-switcher"
					class="flex items-center gap-2 ml-4 pl-4 border-l border-neutral-200"
				>
					{
						Object.entries(languages).map(([l, label]) => (
							<a
								href={
									l === "en"
										? currentPath
										: `/${l}${currentPath}`
								}
								class:list={[
									"px-2 py-1 rounded text-sm font-medium transition-colors",
									l === lang
										? "bg-green-500 text-white"
										: "lang-btn text-neutral-600 hover:bg-neutral-100",
								]}
								onclick={`document.cookie = 'preferred-language=${l}; path=/; max-age=31536000'`}
							>
								{l.toUpperCase()}
							</a>
						))
					}
				</div>
			</div>
			<button id="mobile-menu-btn" class="md:hidden nav-link text-black">
				<svg
					class="w-6 h-6"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
				>
					<path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M4 6h16M4 12h16M4 18h16"></path>
				</svg>
			</button>
		</div>
	</div>
	<div
		id="mobile-menu"
		class="hidden md:hidden bg-white border-t border-neutral-200"
	>
		<div class="px-2 pt-2 pb-3 space-y-1 font-bold">
			<a href={hrefFor('tattoos')} class={ `block px-3 py-2 rounded-md ${isActive('tattoos') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.tattoos")}</a>
			<a href={hrefFor('works')} class={ `block px-3 py-2 rounded-md ${isActive('works') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.works")}</a>
			<a href={hrefFor('ceramics')} class={ `block px-3 py-2 rounded-md ${isActive('ceramics') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.ceramics")}</a>
			<a href={hrefFor('murals')} class={ `block px-3 py-2 rounded-md ${isActive('murals') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.murals")}</a>
			<a href={hrefFor('biography')} class={ `block px-3 py-2 rounded-md ${isActive('biography') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.biography")}</a>
			<a href={hrefFor('faqs')} class={ `block px-3 py-2 rounded-md ${isActive('faqs') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.faqs")}</a>
			<a href={hrefFor('contact')} class={ `block px-3 py-2 rounded-md ${isActive('contact') ? 'bg-green-500 text-white' : 'text-black hover:bg-neutral-50'}` }>{t("nav.contact")}</a>
			<div class="flex gap-2 px-3 py-2 border-t border-neutral-200 mt-2">
				{
					Object.entries(languages).map(([l, label]) => (
						<a
							href={
								l === "en" ? currentPath : `/${l}${currentPath}`
							}
							class:list={[
								"px-3 py-1 rounded text-sm font-medium transition-colors flex-1 text-center",
								l === lang
									? "bg-green-500 text-white"
									: "bg-neutral-100 text-neutral-700",
							]}
							onclick={`document.cookie = 'preferred-language=${l}; path=/; max-age=31536000'`}
						>
							{label}
						</a>
					))
				}
			</div>
		</div>
	</div>
</nav>

<style>
	.nav-link::after {
		content: "";
		position: absolute;
		bottom: -4px;
		left: 50%;
		width: 0;
		height: 2px;
		background-color: #22c55e; /* green-500 */
		transition: all 0.3s ease;
		transform: translateX(-50%);
	}

	.nav-link:hover::after {
		width: 100%;
	}

	.nav-link:hover {
		color: #22c55e; /* green-500 */
	}
</style>

<script>
/*
	Make navbar behavior robust across client-side navigation.
	- Use delegated click handler so mobile toggle works even if node is replaced.
	- Re-query `#navbar` inside the scroll handler so it affects the current DOM node.
	- Make init idempotent to avoid duplicate listeners.
*/
// TypeScript: declare custom window property
declare global {
	interface Window {
		__navScriptsInitialized?: boolean;
	}
}
(function () {
	if (window.__navScriptsInitialized) return;
	window.__navScriptsInitialized = true;

	// Delegated mobile menu toggle — works even if DOM nodes are replaced
	document.addEventListener("click", (ev) => {
		const btn = ev.target && (ev.target as HTMLElement).closest && (ev.target as HTMLElement).closest("#mobile-menu-btn");
		if (btn) {
			const mobileMenu = document.getElementById("mobile-menu");
			mobileMenu?.classList.toggle("hidden");
		}
	});

	// Change navbar background on scroll
	let scrollThreshold = 50; // Start changing background after scrolling 50px

	const onScroll = () => {
		const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
		const navbar = document.getElementById("navbar");
		if (!navbar) return; // nothing to do if navbar isn't present

		if (scrollTop > scrollThreshold) {
			navbar.classList.add("bg-white/95", "backdrop-blur-sm", "shadow-sm");
		} else {
			navbar.classList.remove("bg-white/95", "backdrop-blur-sm", "shadow-sm");
		}
	};

	window.addEventListener("scroll", onScroll, { passive: true });
	// Run once to set initial state (handles non-top landing)
	onScroll();
})();
</script>
