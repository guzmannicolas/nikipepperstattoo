---
import { useTranslations } from "../../../i18n/utils";
import { categoriesWithItems } from "../../../lib/categories";

interface Props {
    lang: "en" | "es";
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Series and their descriptions come from the CMS (only series that have a description).
const currentSeries = categoriesWithItems("works")
    .filter((s) => s.description)
    .map((s) => ({ title: s.name[lang], description: s.description![lang] }));
---

<section class="py-20 px-4 bg-neutral-50 border-y border-neutral-200">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center text-black">
            {t("artworks.seriesTitle")}
        </h2>
        <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-6">
            {
                currentSeries.map((item) => (
                    <div class="p-6 bg-white rounded-xl border border-neutral-200">
                        <h3 class="text-xl font-bold mb-3 text-green-600">
                            {item.title}
                        </h3>
                        <p class="text-neutral-600">{item.description}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
