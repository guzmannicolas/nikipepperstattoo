---
const { lang, t } = Astro.props;
---

<section class="relative py-24 px-4 z-10">
  <div class="max-w-6xl mx-auto">
    <div class="text-center max-w-4xl mx-auto">
      <h2 class="text-4xl md:text-6xl font-bold mb-6 text-black leading-tight">
        {t('home.aboutArtistTitle')}
      </h2>
      <p class="text-lg md:text-xl text-neutral-600 mb-10 leading-relaxed">
        {t('home.aboutArtistSubtitle')}
      </p>
      <a
        href={`/${lang === 'en' ? '' : lang + '/'}biography`}
        class="inline-block px-8 py-4 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors text-lg"
      >
        {t('home.aboutArtistButton')}
      </a>
    </div>
  </div>
</section>
