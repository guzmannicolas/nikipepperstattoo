---
/**
 * StylesSection.astro
 * -------------------
 * This is an Astro Server-Side component. Its primary job is to:
 * 1. Prepare the data (the "cards" array) based on the current language.
 * 2. Import the necessary image assets so Astro can optimize them.
 * 3. Pass all this data to a "Client Island" (React component) for interactivity.
 */

import StylesSectionLogic from "./StylesSectionLogic";
// We import images directly so Astro's asset pipeline can process them (AVIF/WebP conversion)
import koiFish from "../../../assets/tattoos/animals/bird-tattoo-forearm-orange-grey-feathers.avif";
import redPoppies from "../../../assets/tattoos/botanical/red-poppies-blue-cornflowers-arm-tattoo.avif";
import blueFlower from "../../../assets/tattoos/animals/koi-fish-tattoo-lily-pads-water-lilies.avif";

const { t, lang } = Astro.props;

// Helper to handle URL prefixing for multi-language support
const basePath = typeof lang === "string" && lang !== "en" ? `/${lang}` : "";
const tattoosHref = `${basePath}/tattoos`;

/**
 * Definition of the featured styles.
 * Each object contains the key for filtering, localized text, and the image source.
 */
const cards = [
  {
    key: "botanical",
    title: t("tattoos.filterBotanical"),
    description: t("home.botanical.description"),
    badge: t("tattoos.filterBotanical"),
    image: redPoppies.src,
    filterLabel: t("tattoos.filterBotanical"),
    href: tattoosHref,
  },
  {
    key: "animals",
    title: t("tattoos.filterAnimals"),
    description: t("home.animals.description"),
    badge: t("tattoos.filterAnimals"),
    image: koiFish.src,
    filterLabel: t("tattoos.filterAnimals"),
    href: tattoosHref,
  },
  {
    key: "coverups",
    title: t("tattoos.filterCoverups"),
    description: t("home.coverups.description"),
    badge: t("tattoos.filterCoverups"),
    image: blueFlower.src,
    filterLabel: t("tattoos.filterCoverups"),
    href: tattoosHref,
  },
];
---

<!-- 
  The component is hydrated only when it becomes visible in the viewport 
  (client:visible) to save initial load resources.
-->
<StylesSectionLogic
  client:visible
  heading={t("home.stylesTitle")}
  intro={t("home.stylesIntro")}
  cards={cards}
  ctaAllLabel={t("tattoos.filterAll")}
  ctaAllHref={tattoosHref}
/>
