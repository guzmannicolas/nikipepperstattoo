---
/**
 * StylesSection.astro
 * -------------------
 * This is an Astro Server-Side component. Its primary job is to:
 * 1. Prepare the data (the "cards" array) based on the current language.
 * 2. Import the necessary image assets so Astro can optimize them.
 * 3. Pass all this data to a "Client Island" (React component) for interactivity.
 */

import StylesSectionLogic from "./StylesSectionLogic";
import { getLangFromUrl } from "../../../i18n/utils";
import { cover } from "../../../lib/portfolio";
import { categoriesWithItems, type Lang } from "../../../lib/categories";

// First tattoo in each category (featured items first, then CMS order).
function firstSrc(category: string) {
  return (cover("tattoos", category) ?? cover("tattoos"))?.src ?? '';
}

const { t } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// Helper to handle URL prefixing for multi-language support
const basePath = typeof lang === "string" && lang !== "en" ? `/${lang}` : "";
const tattoosHref = `${basePath}/tattoos`;

/**
 * Featured styles: tattoo categories from the CMS that have a description and a filter
 * button (in the client's order), up to 3. The card links to /tattoos?filter=<key>.
 */
const cardLang: Lang = lang === "es" ? "es" : "en";
const cards = categoriesWithItems("tattoos")
  .filter((c) => c.showInFilters && c.description)
  .slice(0, 3)
  .map((c) => ({
    key: c.key,
    title: c.name[cardLang],
    description: c.description![cardLang],
    badge: c.name[cardLang],
    image: firstSrc(c.key),
    filterLabel: c.name[cardLang],
    href: tattoosHref,
  }));
---

<!-- 
  The component is hydrated only when it becomes visible in the viewport 
  (client:visible) to save initial load resources.
-->
<StylesSectionLogic
  client:visible
  heading={t("home.stylesTitle")}
  intro={t("home.stylesIntro")}
  cards={cards}
  ctaAllLabel={t("tattoos.filterAll")}
  ctaAllHref={tattoosHref}
/>
