---
import FeaturedWorkLogic from './FeaturedWorkLogic';

// Recibimos la función de traducción 't' desde el padre (index.astro)
const { t } = Astro.props;

// Import images
import tattoo1 from "../../../assets/tattoos/botanical/blue-flower-tattoo-green-leaves-forearm.avif";
import tattoo2 from "../../../assets/tattoos/botanical/pink-flower-forearm-tattoo-wrist-design.avif";
import tattoo3 from "../../../assets/tattoos/botanical/red-poppies-blue-cornflowers-arm-tattoo.avif";

import work1 from "../../../assets/works/echoes_from_the_deep/orange-rose.avif";
import work2 from "../../../assets/works/echoes_from_the_deep/river-rose-or-lily.avif";
import work3 from "../../../assets/works/echoes_from_the_deep/mind-and-body.avif";

import ceramic1 from "../../../assets/ceramics/decorative/Coral candle holder.avif";
import ceramic2 from "../../../assets/ceramics/functional/Kisses pot.avif";
import ceramic3 from "../../../assets/ceramics/decorative/Leaf mask.avif";

const col1Images = [tattoo1.src, tattoo2.src, tattoo3.src];
const col2Images = [work1.src, work2.src, work3.src];
const col3Images = [ceramic1.src, ceramic2.src, ceramic3.src];

// Usamos la función 't' que vino en las props para obtener los textos
const title = t("featuredWork.title");
const description = t("featuredWork.description");
---

<FeaturedWorkLogic 
  client:load 
  title={title} 
  description={description}
  col1Images={col1Images}
  col2Images={col2Images}
  col3Images={col3Images}
/>
