---
import FeaturedWorkLogic from './FeaturedWorkLogic';

const { t } = Astro.props;

const tattooGlob  = import.meta.glob('/src/assets/tattoos/**/*.avif',  { eager: true });
const worksGlob   = import.meta.glob('/src/assets/works/**/*.avif',    { eager: true });
const ceramicGlob = import.meta.glob('/src/assets/ceramics/**/*.avif', { eager: true });

function firstNSrc(glob: Record<string, any>, n: number) {
  return Object.values(glob).slice(0, n).map((m: any) => m?.default?.src ?? '');
}

const col1Images = firstNSrc(tattooGlob,  3);
const col2Images = firstNSrc(worksGlob,   3);
const col3Images = firstNSrc(ceramicGlob, 3);

// Usamos la función 't' que vino en las props para obtener los textos
const title = t("featuredWork.title");
const description = t("featuredWork.description");
---

<FeaturedWorkLogic
  client:visible
  title={title} 
  description={description}
  col1Images={col1Images}
  col2Images={col2Images}
  col3Images={col3Images}
/>
