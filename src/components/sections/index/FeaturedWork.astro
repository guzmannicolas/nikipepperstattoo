---
import FeaturedWorkLogic from './FeaturedWorkLogic';
import { covers } from '../../../lib/portfolio';

const { t } = Astro.props;

// Items marked "featured" in the CMS come first.
const col1Images = covers('tattoos',  3).map((img) => img.src);
const col2Images = covers('works',    3).map((img) => img.src);
const col3Images = covers('ceramics', 3).map((img) => img.src);

// Usamos la función 't' que vino en las props para obtener los textos
const title = t("featuredWork.title");
const description = t("featuredWork.description");
---

<FeaturedWorkLogic
  client:visible
  title={title} 
  description={description}
  col1Images={col1Images}
  col2Images={col2Images}
  col3Images={col3Images}
/>
