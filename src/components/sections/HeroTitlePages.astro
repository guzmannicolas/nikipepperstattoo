---
const { lang, t, ns = 'tattoos' } = Astro.props as { lang?: string; t: any; ns?: string };
---

	<!-- Content -->
	<div class="relative z-10 text-center mb-16">
		<h1 class="text-5xl font-serif mb-4 text-black">
			{t(`${ns}.title`)}
		</h1>
		<p class="text-neutral-600 text-lg max-w-2xl mx-auto pt-10">
			{t(`${ns}.description`)}
		</p>
	</div>
