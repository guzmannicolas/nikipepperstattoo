---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import tattooHero from "../assets/tattoos/botanical/forearm-pink-lotus-tattoo-leaves.jpg";
import ceramicHero from "../assets/ceramics/Mateta Pisces - Front.avif";
import bioHero from "../assets/home/Niki-about-me.avif";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  {
    href: `/${lang === "en" ? "" : lang + "/"}tattoos`,
    title: t("artworks.exploreTattoos"),
    desc: t("artworks.exploreTattoosDesc"),
    img: tattooHero,
    alt: t("tattoos.title"),
  },
  {
    href: `/${lang === "en" ? "" : lang + "/"}ceramics`,
    title: t("artworks.exploreCeramics"),
    desc: t("artworks.exploreCeramicsDesc"),
    img: ceramicHero,
    alt: t("ceramics.title"),
  },
  {
    href: `/${lang === "en" ? "" : lang + "/"}biography`,
    title: t("artworks.exploreAbout"),
    desc: t("artworks.exploreAboutDesc"),
    img: bioHero,
    alt: t("biography.title"),
  },
];
---

<!-- Explore More / Cross-linking Section -->
<section class="py-20 px-4 max-w-7xl mx-auto">
  <div class="text-center mb-12 space-y-3">
    <p class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 text-green-700 text-sm font-semibold tracking-wide">
      {t("artworks.exploreSubtitle")}
    </p>
    <h2 class="text-3xl font-bold text-black">{t("artworks.exploreTitle")}</h2>
  </div>

  <div class="grid md:grid-cols-3 gap-6">
    {links.map((card) => (
      <a
        href={card.href}
        class="group relative overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
      >
        <div class="aspect-[4/3] overflow-hidden bg-neutral-100">
          <img
            src={card.img.src}
            alt={card.alt}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-black/20 to-transparent opacity-60 group-hover:opacity-70 transition-opacity"></div>
        </div>

        <div class="relative -mt-14 px-6 pb-6">
          <div class="inline-flex items-center gap-2 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-neutral-700 shadow-sm backdrop-blur">
            <span class="w-2 h-2 rounded-full bg-green-500"></span>
            {t("home.title")}
          </div>
          <div class="mt-3 space-y-2">
            <h3 class="text-xl font-bold text-white drop-shadow group-hover:text-green-50">
              {card.title}
            </h3>
            <p class="text-sm text-neutral-100/90 leading-relaxed">
              {card.desc}
            </p>
          </div>
          <div class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-green-100 group-hover:text-white">
            {t("home.viewGallery")}
            <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-green-500/80 text-white transition group-hover:bg-green-500">
              →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
