---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang); // <--- AQUÍ SE DEFINE t
---

<!-- Explore More / Cross-linking Section -->
<section class="py-20 px-4 max-w-7xl mx-auto">
  <div class="text-center mb-12">
    <h2 class="text-3xl font-bold mb-4 text-black">
      {t("artworks.exploreTitle")}
    </h2>
    <p class="text-neutral-600 text-lg">{t("artworks.exploreSubtitle")}</p>
  </div>

  <div class="grid md:grid-cols-3 gap-8">
    <!-- Link to Tattoos -->
    <a
      href={`/${lang === "en" ? "" : lang + "/"}tattoos`}
      class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg"
    >
      <div
        class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center"
      >
        <svg
          class="w-16 h-16 text-green-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"
          ></path>
        </svg>
      </div>
      <div class="p-6">
        <h3
          class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors"
        >
          {t("artworks.exploreTattoos")}
        </h3>
        <p class="text-neutral-600 text-sm">
          {t("artworks.exploreTattoosDesc")}
        </p>
      </div>
    </a>

    <!-- Link to Ceramics -->
    <a
      href={`/${lang === "en" ? "" : lang + "/"}ceramics`}
      class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg"
    >
      <div
        class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center"
      >
        <svg
          class="w-16 h-16 text-green-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
          ></path>
        </svg>
      </div>
      <div class="p-6">
        <h3
          class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors"
        >
          {t("artworks.exploreCeramics")}
        </h3>
        <p class="text-neutral-600 text-sm">
          {t("artworks.exploreCeramicsDesc")}
        </p>
      </div>
    </a>

    <!-- Link to Biography -->
    <a
      href={`/${lang === "en" ? "" : lang + "/"}biography`}
      class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg"
    >
      <div
        class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center"
      >
        <svg
          class="w-16 h-16 text-green-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
          ></path>
        </svg>
      </div>
      <div class="p-6">
        <h3
          class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors"
        >
          {t("artworks.exploreAbout")}
        </h3>
        <p class="text-neutral-600 text-sm">{t("artworks.exploreAboutDesc")}</p>
      </div>
    </a>
  </div>
</section>
