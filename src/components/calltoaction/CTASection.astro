---
const { lang, t, ns = '' } = Astro.props as { lang?: string; t: any; ns?: string };
const subtitle = t(`${ns}.ctaSubtitle`) || t(`${ns}.ctaDescription`);
---

<section class="py-20 px-4 bg-neutral-50 border-y border-neutral-200">
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="text-3xl font-bold mb-4 text-black">{t(`${ns}.ctaTitle`)}</h2>
    <p class="text-neutral-600 mb-8 text-lg">{subtitle}</p>
    <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="inline-block px-8 py-3 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors">
      {t(`${ns}.ctaButton`) }
    </a>
  </div>
</section>
