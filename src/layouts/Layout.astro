---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import LoadingSplash from '../components/animation/loading/LoadingSplash.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { ViewTransitions } from 'astro:transitions'

interface Props {
	title: string;
	description?: string;
	image?: string;
	pageSchema?: object;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = 'Tattoo artist, ceramist, and visual artist', image, pageSchema } = Astro.props;

const siteUrl = 'https://nikipepperstattoo.com';
const currentPath = Astro.url.pathname;
const ogImage = image ?? `${siteUrl}/images/home/background-hero.jpeg`;
const canonicalUrl = siteUrl + currentPath;

let enUrl: string;
let esUrl: string;
if (lang === 'es') {
	const withoutEs = currentPath.replace(/^\/es/, '') || '/';
	enUrl = siteUrl + withoutEs;
	esUrl = siteUrl + currentPath;
} else {
	enUrl = siteUrl + currentPath;
	esUrl = siteUrl + '/es' + (currentPath === '/' ? '/' : currentPath);
}

const localBusinessSchema = {
	'@context': 'https://schema.org',
	'@type': 'TattooParlor',
	name: 'Niki Peppers Tattoo',
	url: siteUrl,
	email: 'nikipepperstattoo@gmail.com',
	image: ogImage,
	description: 'Multidisciplinary artist specializing in botanical tattoos, handmade ceramics, and visual art.',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Melbourne',
		addressCountry: 'AU',
	},
	openingHours: ['Mo-Fr 10:00-19:00', 'Sa 10:00-16:00'],
	sameAs: [
		'https://instagram.com/nikipepperstattoo',
		'https://facebook.com/nikipepperstattoo',
	],
};
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="author" content="Niki Peppers" />
		<meta name="theme-color" content="#ffffff" />
		<meta name="generator" content={Astro.generator} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Niki Peppers" />
		<meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_AU'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={canonicalUrl} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<!-- Canonical & hreflang -->
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="es" href={esUrl} />
		<link rel="alternate" hreflang="x-default" href={enUrl} />

		<link rel="icon" type="image/png" href="/titulo-header.png" />
		<link rel="icon" type="image/png" href="/logo-loading.png" sizes="192x192" />
		<link rel="apple-touch-icon" href="/titulo-header.png" />

		<title>{title}</title>
		<ViewTransitions />

		<!-- LocalBusiness structured data -->
		<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

		<!-- Page-specific structured data -->
		{pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema)} />}
	</head>
	<body class="min-h-screen bg-white text-neutral-900">
		<script is:inline>
			(function() {
				// Only redirect on exact root path
				if (window.location.pathname !== '/') return;

				// 1. Check localStorage (set by language selector)
				var saved = localStorage.getItem('preferred-language');

				// 2. Check cookie (set by nav language links)
				if (!saved) {
					var match = document.cookie.match(/preferred-language=([^;]+)/);
					if (match) saved = match[1];
				}

				// 3. Detect browser language
				if (!saved) {
					var browserLang = (navigator.language || '').toLowerCase();
					saved = browserLang.startsWith('es') ? 'es' : 'en';
				}

				// Save preference in both stores
				localStorage.setItem('preferred-language', saved);
				document.cookie = 'preferred-language=' + saved + '; path=/; max-age=31536000';

				// Redirect
				if (saved === 'es') {
					window.location.replace('/es/');
				}
				// If 'en', stay on / (already the English home)
			})();
		</script>
		<LoadingSplash />
		<Navigation />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>
