---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import CrossPromo from "../components/calltoaction/CrossPromo.astro";
import FilterButtons from "../components/buttons/FilterButtons.astro";
import HeroTitlePages from "../components/sections/HeroTitlePages.astro";
import Gallery from "../components/ui/Gallery.astro";
import CTASection from "../components/calltoaction/CTASection.astro";
import tattoosData from "../data/tattoos.json";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const tattooImages = import.meta.glob(
	"/src/assets/tattoos/**/*.{jpeg,jpg,png,avif}",
	{ eager: true },
);

// Leer filtro de la query
const url = new URL(Astro.url);
const filterParam = url.searchParams.get("filter") || "all";

let galleryItems = tattoosData.items.map((item) => {
	const srcPath = item.images && item.images[0] ? item.images[0].path : "";
	const imageModule = (tattooImages as any)[srcPath];
	const image = imageModule ? imageModule.default : srcPath;
	const localizedTitle = item.title?.[lang] || item.title?.en || "";
	const localizedCategories =
		lang === "es"
			? item.category_es || item.category || ""
			: item.category || "";
	return {
		image,
		title: localizedTitle,
		alt: item.images && item.images[0] ? item.images[0].alt || "" : "",
		categories: item.category,
		displayCategories: localizedCategories,
	};
});
if (filterParam && filterParam !== "all") {
	galleryItems = galleryItems.filter((item) => {
		if (!item.categories) return false;
		if (Array.isArray(item.categories)) {
			return item.categories.includes(filterParam);
		}
		return String(item.categories)
			.split(",")
			.map((s) => s.trim())
			.includes(filterParam);
	});
}

const tattoosGallerySchema = {
	"@context": "https://schema.org",
	"@type": "ImageGallery",
	name: "Tattoo Portfolio - Niki Peppers",
	description: t("tattoos.description"),
	url: "https://nikipepperstattoo.com/tattoos",
};
---

<Layout
	title={`${t("tattoos.title")} - Niki Peppers`}
	description={t("tattoos.description")}
	pageSchema={tattoosGallerySchema}
>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="tattoos" />

		<Gallery
			items={galleryItems}
			showInitialCount={6}
			loadMoreLabel={t("tattoos.loadMore")}
		>
			<div slot="filters">
				{
					(() => {
						const buttons = [
							{
								label: t("tattoos.filterAll"),
								value: "all",
								active: filterParam === "all",
							},
							{
								label: t("tattoos.filterBotanical"),
								value: "botanical",
								active: filterParam === "botanical",
							},
							{
								label: t("tattoos.filterAnimals"),
								value: "animals",
								active: filterParam === "animals",
							},
							{
								label: t("tattoos.filterCoverups"),
								value: "coverups",
								active: filterParam === "coverups",
							},
						];
						return <FilterButtons buttons={buttons} />;
					})()
				}
			</div>
		</Gallery>
	</section>

	<!-- CTA Section (componentized) -->
	<CTASection lang={lang} t={t} ns="tattoos" />

	<CrossPromo lang={lang} />
</Layout>
