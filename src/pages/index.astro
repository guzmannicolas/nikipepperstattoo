---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import HeroSection from "../components/sections/HeroSection.astro";
import FeaturedWork from "../components/sections/FeaturedWork.astro";
import AboutArtistSection from "../components/sections/AboutArtistSection.astro";
import StylesSection from "../components/sections/StylesSection.astro";
import NewsletterSection from "../components/sections/NewsletterSection.astro";
import AboutPreviewSection from "../components/sections/AboutPreviewSection.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`Niki Peppers - ${t('home.title')}`}>
	<!-- Hero + About Artist Section with Video Background -->
	<div class="relative bg-white">

		<!-- Hero Section (componentized) -->
		<HeroSection lang={lang} t={t} />

		<!-- Featured Work Section -->
		<FeaturedWork lang={lang} t={t} />

		<!-- About Artist Section (componentized) -->
		<AboutArtistSection lang={lang} t={t} />
	</div>

	<!-- Styles Section (componentized) -->
	<StylesSection t={t} />

	<!-- Newsletter Section (componentized) -->
	<NewsletterSection t={t} />

	<!-- About Preview (componentized) -->
	<AboutPreviewSection lang={lang} t={t} />
</Layout>
