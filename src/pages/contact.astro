---
import Layout from "../layouts/Layout.astro";
import CrossPromo from "../components/calltoaction/CrossPromo.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import HeroTitlePages from "../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t('contact.title')} - ${t('home.title')}`} description={t('contact.description')}>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="contact" />

		<div class="grid md:grid-cols-2 gap-12">
			<!-- Contact Form -->
			<div>
				<form action="https://formsubmit.co/nikipepperstattoo@gmail.com" method="POST" class="space-y-6" id="contact-form">
					<!-- Honeypot field (hidden from users) -->
					<input type="text" name="hp_field" id="hp-field" autocomplete="off" tabindex="-1"
						style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;opacity:0" />
					<!-- Timestamp when form was rendered -->
					<input type="hidden" name="form_start" id="form-start" value="" />
					<div>
						<label for="name" class="block text-sm font-semibold mb-2 text-black">{t('contact.nameLabel')} *</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
							placeholder={t('contact.namePlaceholder')}
						/>
					</div>
					<div>
						<label for="email" class="block text-sm font-semibold mb-2 text-black">{t('contact.emailLabel')} *</label>
						<input
							type="email"
							id="email"
							name="email"
							required
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
							placeholder={t('contact.emailPlaceholder')}
						/>
					</div>
					<div>
						<label for="phone" class="block text-sm font-semibold mb-2 text-black">{t('contact.phoneLabel')}</label>
						<input
							type="tel"
							id="phone"
							name="phone"
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
							placeholder={t('contact.phonePlaceholder')}
						/>
					</div>
					<div>
						<label for="service-type" class="block text-sm font-semibold mb-2 text-black">{t('contact.serviceLabel')}</label>
						<select
							id="service-type"
							name="service_type"
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
						>
							<option value="">{t('contact.serviceSelect')}</option>
							<option value="tattoo">{t('contact.serviceTattoo')}</option>
							<option value="ceramic">{t('contact.serviceCeramic')}</option>
							<option value="mural">{t('contact.serviceMural')}</option>
							<option value="other">{t('contact.serviceOther')}</option>
						</select>
					</div>
					<div>
						<label for="size" class="block text-sm font-semibold mb-2 text-black">{t('contact.sizeLabel')}</label>
						<select
							id="size"
							name="size"
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
						>
							<option value="">{t('contact.sizeSelect')}</option>
							<option value="small">{t('contact.sizeSmall')}</option>
							<option value="medium">{t('contact.sizeMedium')}</option>
							<option value="large">{t('contact.sizeLarge')}</option>
							<option value="xlarge">{t('contact.sizeXLarge')}</option>
						</select>
					</div>
					<div>
						<label for="message" class="block text-sm font-semibold mb-2 text-black">{t('contact.messageLabel')} *</label>
						<textarea
							id="message"
							name="message"
							required
							rows="6"
							class="w-full px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors resize-none text-black"
							placeholder={t('contact.messagePlaceholder')}
						></textarea>
					</div>
					<button
						type="submit"
						class="w-full px-8 py-3 bg-black hover:bg-neutral-800 rounded-lg font-semibold transition-colors text-white"
					>
						{t('contact.submitButton')}
					</button>
					<input type="hidden" name="_subject" value="New contact from website" />
				</form>
			</div>

			<!-- Contact Info -->
			<div class="space-y-8">
				<div class="bg-white p-8 rounded-xl border-2 border-neutral-200">
					<h2 class="text-2xl font-bold mb-6 text-black">{t('contact.infoTitle')}</h2>
					<div class="space-y-4">
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-green-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold mb-1 text-black">{t('contact.emailTitle')}</h3>
								<a href="mailto:nikipepperstattoo@gmail.com" class="text-neutral-600 hover:text-green-600 transition-colors">
									nikipepperstattoo@gmail.com
								</a>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-green-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold mb-1 text-black">{t('contact.whatsappTitle')}</h3>
								<a href="https://wa.me/5491112345678" class="text-neutral-600 hover:text-green-600 transition-colors">
									+54 9 11 1234-5678
								</a>
							</div>
						</div>
						<div class="flex items-start gap-4">
							<div class="w-10 h-10 bg-green-500/10 rounded-lg flex items-center justify-center flex-shrink-0">
								<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
								</svg>
							</div>
							<div>
								<h3 class="font-semibold mb-1 text-black">{t('contact.locationTitle')}</h3>
								<p class="text-neutral-600">
									{t('contact.locationText')}<br/>
									<span class="text-sm">{t('contact.locationNote')}</span>
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="bg-white p-8 rounded-xl border-2 border-neutral-200">
					<h2 class="text-2xl font-bold mb-4 text-black">{t('contact.socialTitle')}</h2>
					<p class="text-neutral-600 mb-6">
						{t('contact.socialText')}
					</p>
					<div class="flex gap-4">
						<a href="#" class="w-12 h-12 bg-green-500/10 hover:bg-green-500/20 rounded-lg flex items-center justify-center transition-colors" aria-label="Instagram">
							<svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
							</svg>
						</a>
						<a href="#" class="w-12 h-12 bg-green-500/10 hover:bg-green-500/20 rounded-lg flex items-center justify-center transition-colors" aria-label="Facebook">
							<svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 24 24">
								<path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
							</svg>
						</a>
					</div>
				</div>

				<div class="bg-neutral-50 p-8 rounded-xl border-2 border-neutral-200">
					<h3 class="text-xl font-bold mb-3 text-black">{t('contact.hoursIcon')} {t('contact.hoursTitle')}</h3>
					<p class="text-neutral-600 mb-2">
						<strong>{t('contact.hoursWeekdays')}</strong> {t('contact.hoursWeekdaysTime')}
					</p>
					<p class="text-neutral-600 mb-2">
						<strong>{t('contact.hoursSaturday')}</strong> {t('contact.hoursSaturdayTime')}
					</p>
					<p class="text-neutral-600">
						<strong>{t('contact.hoursSunday')}</strong> {t('contact.hoursSundayTime')}
					</p>
					<p class="text-neutral-500 text-sm mt-4">
						{t('contact.hoursNote')}
					</p>
				</div>
			</div>
		</div>
	</section>

	<CrossPromo />

	<!-- Modal markup (hidden by default) -->
	<div id="contact-modal" class="fixed inset-0 z-50 hidden items-center justify-center">
		<div id="contact-modal-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
		<div class="relative z-10 max-w-lg mx-auto bg-white rounded-2xl p-8 shadow-lg transform transition-all">
			<button id="contact-modal-close-x" aria-label="close" class="absolute top-3 right-3 text-neutral-600 hover:text-black">✕</button>
			<h3 class="text-2xl font-bold mb-4 text-black">{t('contact.thanksTitle')}</h3>
			<p class="text-neutral-700 mb-6">{t('contact.thanksMessage')}</p>
			<div class="flex justify-end gap-3">
				<button id="contact-modal-accept" class="px-6 py-2 bg-green-500 text-white rounded-full">{t('contact.thanksAccept')}</button>
			</div>
		</div>
	</div>

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const RATE_LIMIT_MS = 2 * 60 * 1000; // 2 minutes between sends
			const MIN_FILL_TIME_MS = 3000; // 3 seconds minimum
			const STORAGE_KEY = 'contact:lastSubmit';

			const params = new URLSearchParams(window.location.search);
			const show = params.get('sent') === '1';
			const modal = document.getElementById('contact-modal');
			const backdrop = document.getElementById('contact-modal-backdrop');
			const closeX = document.getElementById('contact-modal-close-x');
			const acceptBtn = document.getElementById('contact-modal-accept');
			/** @type {HTMLFormElement | null} */
			const form = /** @type {HTMLFormElement | null} */ (document.getElementById('contact-form'));
			/** @type {HTMLInputElement | null} */
			const hpField = /** @type {HTMLInputElement | null} */ (document.getElementById('hp-field'));
			/** @type {HTMLInputElement | null} */
			const formStartInput = /** @type {HTMLInputElement | null} */ (document.getElementById('form-start'));

			let startTime = Date.now();
			if (formStartInput instanceof HTMLInputElement) formStartInput.value = String(startTime);

			function openModal() {
				if (!modal) return;
				modal.classList.remove('hidden');
				modal.classList.add('flex');
				try {
					const url = new URL(window.location.href);
					url.searchParams.delete('sent');
					window.history.replaceState({}, document.title, url.pathname + url.search + url.hash);
				} catch (e) {}
			}

			function closeModal() {
				if (!modal) return;
				modal.classList.remove('flex');
				modal.classList.add('hidden');
			}

			if (show) openModal();

			backdrop?.addEventListener('click', closeModal);
			closeX?.addEventListener('click', closeModal);
			acceptBtn?.addEventListener('click', closeModal);
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') closeModal();
			});

			/** @param {string} msg */
			function showInlineError(msg: string) {
				const existing = document.getElementById('contact-error');
				if (existing) existing.remove();
				const el = document.createElement('div');
				el.id = 'contact-error';
				el.className = 'mb-4 p-3 rounded bg-red-50 border border-red-200 text-red-700';
				el.textContent = msg;
				form?.parentNode?.insertBefore(el, form);
			}

			if (form) {
				form.addEventListener('submit', async (e) => {
					e.preventDefault();

					// Honeypot check
					if (hpField instanceof HTMLInputElement && hpField.value.trim() !== '') {
						showInlineError('Error sending message. Please try again later.');
						return;
					}

					// Minimum fill time check
					const now = Date.now();
					const elapsed = now - startTime;
					if (elapsed < MIN_FILL_TIME_MS) {
						showInlineError('Please take a moment to complete the form before submitting.');
						return;
					}

					// Rate limit check (per browser)
					const last = Number(localStorage.getItem(STORAGE_KEY) || 0);
					if (last && (now - last) < RATE_LIMIT_MS) {
						const waitSec = Math.ceil((RATE_LIMIT_MS - (now - last)) / 1000);
						showInlineError(`Please wait ${waitSec}s before sending another message.`);
						return;
					}

					/** @type {HTMLButtonElement | null} */
					const submitBtn = form.querySelector('button[type="submit"]');
					if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = true;
					if (!(form instanceof HTMLFormElement)) {
						showInlineError('Form error.');
						if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
						return;
					}
					const formData = new FormData(form);

					try {
						const res = await fetch('https://formsubmit.co/ajax/nikipepperstattoo@gmail.com', {
							method: 'POST',
							body: formData,
							headers: { 'Accept': 'application/json' }
						});

						if (res.ok) {
							localStorage.setItem(STORAGE_KEY, String(Date.now()));
							openModal();
							form.reset();
							startTime = Date.now();
							if (formStartInput instanceof HTMLInputElement) formStartInput.value = String(startTime);
							const existing = document.getElementById('contact-error');
							if (existing) existing.remove();
						} else {
							const json = await res.json().catch(() => null);
							const message = json?.message || 'Error sending message. Please try again later.';
							showInlineError(message);
						}
					} catch (err) {
						showInlineError('Network error. Please try again later.');
					} finally {
						if (submitBtn instanceof HTMLButtonElement) submitBtn.disabled = false;
					}
				});
			}
		});
	</script>
</Layout>
