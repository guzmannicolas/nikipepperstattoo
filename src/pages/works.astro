---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Sample painting data - replace with real data
const paintings = [
	{ id: 1, title: 'Ethereal Dreams #1', series: 'ethereal', technique: 'oil', dimensions: '80x100 cm', year: 2024 },
	{ id: 2, title: 'Urban Souls #3', series: 'urban', technique: 'acrylic', dimensions: '70x90 cm', year: 2024 },
	{ id: 3, title: 'Nature\'s Whisper #2', series: 'nature', technique: 'oil', dimensions: '60x80 cm', year: 2023 },
	{ id: 4, title: 'Ethereal Dreams #2', series: 'ethereal', technique: 'mixed', dimensions: '100x120 cm', year: 2024 },
	{ id: 5, title: 'Urban Souls #1', series: 'urban', technique: 'acrylic', dimensions: '50x70 cm', year: 2023 },
	{ id: 6, title: 'Abstract Emotions #4', series: 'abstract', technique: 'oil', dimensions: '90x110 cm', year: 2024 },
	{ id: 7, title: 'Nature\'s Whisper #5', series: 'nature', technique: 'watercolor', dimensions: '40x60 cm', year: 2023 },
	{ id: 8, title: 'Abstract Emotions #2', series: 'abstract', technique: 'mixed', dimensions: '80x100 cm', year: 2024 },
	{ id: 9, title: 'Ethereal Dreams #3', series: 'ethereal', technique: 'oil', dimensions: '70x90 cm', year: 2024 },
];
---

<Layout title={`${t('artworks.title')} - Niki Peppers`} description={t('artworks.description')}>
	<!-- Hero Section -->
	<section class="py-20 px-4 max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h1 class="text-5xl font-bold mb-4 text-black">{t('artworks.title')}</h1>
			<p class="text-neutral-600 text-lg max-w-2xl mx-auto">
				{t('artworks.description')}
			</p>
		</div>

		<!-- Filter Buttons by Series -->
		<div class="flex flex-wrap justify-center gap-4 mb-12">
			<button class="series-filter active px-6 py-2 rounded-full bg-green-500 text-white font-semibold" data-series="all">
				{t('artworks.filters.all')}
			</button>
			<button class="series-filter px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black font-semibold transition-all" data-series="ethereal">
				{t('artworks.filters.ethereal')}
			</button>
			<button class="series-filter px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black font-semibold transition-all" data-series="urban">
				{t('artworks.filters.urban')}
			</button>
			<button class="series-filter px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black font-semibold transition-all" data-series="nature">
				{t('artworks.filters.nature')}
			</button>
			<button class="series-filter px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black font-semibold transition-all" data-series="abstract">
				{t('artworks.filters.abstract')}
			</button>
		</div>

		<!-- Paintings Gallery -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
			{paintings.map((painting) => (
				<div class="painting-item group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-xl" data-series={painting.series}>
					<!-- Image placeholder -->
					<div class="aspect-[3/4] bg-neutral-100 flex items-center justify-center relative overflow-hidden">
						<div class="text-neutral-400 text-center p-4">
							<p class="font-semibold">{painting.title}</p>
						</div>
						<!-- Series badge -->
						<div class="absolute top-4 right-4 px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-bold text-green-600">
							{t(`artworks.filters.${painting.series}`)}
						</div>
					</div>
					
					<!-- Painting details -->
					<div class="p-6">
						<h3 class="text-xl font-bold mb-3 text-black">{painting.title}</h3>
						
						<div class="space-y-2 text-sm text-neutral-600">
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
								</svg>
								<span><strong>{t('artworks.technique')}:</strong> {t(`artworks.techniques.${painting.technique}`)}</span>
							</div>
							
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path>
								</svg>
								<span><strong>{t('artworks.dimensions')}:</strong> {painting.dimensions}</span>
							</div>
							
							<div class="flex items-center gap-2">
								<svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
								</svg>
								<span><strong>{t('artworks.year')}:</strong> {painting.year}</span>
							</div>
						</div>

						<button class="mt-4 w-full px-4 py-2 bg-neutral-50 hover:bg-green-50 border border-neutral-200 hover:border-green-400 text-black rounded-lg font-semibold transition-all">
							{t('artworks.viewDetails')}
						</button>
					</div>
				</div>
			))}
		</div>

		<!-- Load More -->
		<div class="text-center mt-12">
			<button class="px-8 py-3 bg-transparent border-2 border-black hover:bg-neutral-50 text-black rounded-lg font-semibold transition-colors">
				{t('artworks.loadMore')}
			</button>
		</div>
	</section>

	<!-- About Series Section -->
	<section class="py-20 px-4 bg-neutral-50 border-y border-neutral-200">
		<div class="max-w-4xl mx-auto">
			<h2 class="text-3xl font-bold mb-8 text-center text-black">{t('artworks.seriesTitle')}</h2>
			<div class="grid md:grid-cols-2 gap-6">
				<div class="p-6 bg-white rounded-xl border border-neutral-200">
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('artworks.filters.ethereal')}</h3>
					<p class="text-neutral-600">{t('artworks.seriesDesc.ethereal')}</p>
				</div>
				<div class="p-6 bg-white rounded-xl border border-neutral-200">
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('artworks.filters.urban')}</h3>
					<p class="text-neutral-600">{t('artworks.seriesDesc.urban')}</p>
				</div>
				<div class="p-6 bg-white rounded-xl border border-neutral-200">
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('artworks.filters.nature')}</h3>
					<p class="text-neutral-600">{t('artworks.seriesDesc.nature')}</p>
				</div>
				<div class="p-6 bg-white rounded-xl border border-neutral-200">
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('artworks.filters.abstract')}</h3>
					<p class="text-neutral-600">{t('artworks.seriesDesc.abstract')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 px-4 bg-gradient-to-b from-white to-neutral-50">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="text-3xl font-bold mb-4 text-black">{t('artworks.ctaTitle')}</h2>
			<p class="text-neutral-600 mb-8 text-lg">
				{t('artworks.ctaSubtitle')}
			</p>
			<div class="flex flex-wrap justify-center gap-4">
				<a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="px-8 py-3 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors">
					{t('artworks.ctaButton')}
				</a>
				<a href={`/${lang === 'en' ? '' : lang + '/'}biography`} class="px-8 py-3 bg-transparent border-2 border-black hover:bg-neutral-50 text-black rounded-lg font-semibold transition-colors">
					{t('artworks.ctaSecondary')}
				</a>
			</div>
		</div>
	</section>

	<script>
		const seriesFilters = document.querySelectorAll('.series-filter');
		const paintingItems = document.querySelectorAll('.painting-item');

		seriesFilters.forEach(btn => {
			btn.addEventListener('click', () => {
				const series = btn.getAttribute('data-series');
				
				// Update active button
				seriesFilters.forEach(b => {
					b.classList.remove('active', 'bg-green-500', 'text-white');
					b.classList.add('bg-white', 'border-2', 'border-neutral-200');
				});
				btn.classList.add('active', 'bg-green-500', 'text-white');
				btn.classList.remove('bg-white', 'border-2', 'border-neutral-200');

				// Filter items
				paintingItems.forEach(item => {
					if (series === 'all' || item.getAttribute('data-series') === series) {
						item.classList.remove('hidden');
					} else {
						item.classList.add('hidden');
					}
				});
			});
		});
	</script>

		<!-- Explore More / Cross-linking Section -->
	<section class="py-20 px-4 max-w-7xl mx-auto">
		<div class="text-center mb-12">
			<h2 class="text-3xl font-bold mb-4 text-black">{t('artworks.exploreTitle')}</h2>
			<p class="text-neutral-600 text-lg">{t('artworks.exploreSubtitle')}</p>
		</div>

		<div class="grid md:grid-cols-3 gap-8">
			<!-- Link to Tattoos -->
			<a href={`/${lang === 'en' ? '' : lang + '/'}tattoos`} class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center">
					<svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
					</svg>
				</div>
				<div class="p-6">
					<h3 class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors">{t('artworks.exploreTattoos')}</h3>
					<p class="text-neutral-600 text-sm">{t('artworks.exploreTattoosDesc')}</p>
				</div>
			</a>

			<!-- Link to Ceramics -->
			<a href={`/${lang === 'en' ? '' : lang + '/'}ceramics`} class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center">
					<svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
					</svg>
				</div>
				<div class="p-6">
					<h3 class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors">{t('artworks.exploreCeramics')}</h3>
					<p class="text-neutral-600 text-sm">{t('artworks.exploreCeramicsDesc')}</p>
				</div>
			</a>

			<!-- Link to Biography -->
			<a href={`/${lang === 'en' ? '' : lang + '/'}biography`} class="group bg-white rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="aspect-video bg-gradient-to-br from-green-50 to-neutral-50 flex items-center justify-center">
					<svg class="w-16 h-16 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
					</svg>
				</div>
				<div class="p-6">
					<h3 class="text-xl font-bold mb-2 text-black group-hover:text-green-600 transition-colors">{t('artworks.exploreAbout')}</h3>
					<p class="text-neutral-600 text-sm">{t('artworks.exploreAboutDesc')}</p>
				</div>
			</a>
		</div>
	</section>
</Layout>
