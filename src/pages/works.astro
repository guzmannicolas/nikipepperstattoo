---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import CTASection from "../components/calltoaction/CTASection.astro";
import CrossPromo from "../components/calltoaction/CrossPromo.astro";
import GalleryPlus from "../components/ui/GalleryPlus.astro";
import FilterButtons from "../components/buttons/FilterButtons.astro";
import AboutSeriesSection from "../components/sections/works/AboutSeriesSection.astro";
import worksData from "../data/works.json";
import HeroTitlePages from "../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const paintings = worksData;

const images = import.meta.glob(
	"/src/assets/works/**/*.{jpeg,jpg,png,gif,avif}",
	{ eager: true },
);

const galleryItems = paintings.map((p) => {
	const imagePath = p.image;
	const imageModule = images[imagePath];
	const localizedTitle = p.title?.[lang] || p.title?.en || "";
	const localizedTechnique = lang === "es" ? p.technique_es || p.technique : p.technique;
	const displayCategories = t(`artworks.filters.${p.series}`) || p.series;
	return {
		...p,
		title: localizedTitle,
		technique: localizedTechnique,
		categories: p.series,
		displayCategories,
		image: imageModule ? (imageModule as any).default : "",
	};
});
---

<Layout
	title={`${t("artworks.title")} - Niki Peppers`}
	description={t("artworks.description")}
>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="artworks" />

		<GalleryPlus
			items={galleryItems}
			showInitialCount={6}
			loadMoreLabel={t("tattoos.loadMore")}
		>
			<div slot="filters">
				{
					(() => {
						const buttons = [
							{
								label: t("artworks.filters.all") || "All",
								value: "all",
								active: true,
							},
							{
								label:
									t("artworks.filters.echoes") ||
									"Echoes from the deep",
								value: "echoes",
							},
							{
								label:
									t("artworks.filters.gestures") ||
									"Amidst gestures...",
								value: "gestures",
							},
							{
								label:
									t("artworks.filters.childhood") ||
									"Childhood",
								value: "childhood",
							},
							{
								label:
									t("artworks.filters.on_demand") ||
									"On Demand",
								value: "on_demand",
							},
						];
						return <FilterButtons buttons={buttons} />;
					})()
				}
			</div>
		</GalleryPlus>
	</section>

	<!-- About Series Section -->
	<AboutSeriesSection lang={lang} />

	<!-- CTA Section (componentized) -->
	<CTASection lang={lang} t={t} ns="artworks" />

	<CrossPromo lang={lang} />
</Layout>
