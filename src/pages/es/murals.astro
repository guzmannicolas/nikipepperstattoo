---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import CTASection from "../../components/calltoaction/CTASection.astro";
import CrossPromo from "../../components/calltoaction/CrossPromo.astro";
import GalleryPlus from "../../components/ui/GalleryPlus.astro";
import muralsData from "../../data/murals.json";
import HeroTitlePages from "../../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const muralImages = import.meta.glob("/src/assets/murals/*.{jpeg,jpg,png,avif}", { eager: true });

const galleryItems = muralsData.map((item) => {
  const srcPath = item.image;
  const imageModule = (muralImages as any)[srcPath];
  const image = imageModule ? imageModule.default : srcPath;
  const localizedTitle =
    typeof item.title === "object"
      ? item.title[lang as keyof typeof item.title] || item.title.en
      : item.title;
  return {
    image,
    title: localizedTitle,
    alt: localizedTitle,
    year: item.year,
  };
});
---

<Layout title={`${t('murals.title')} - Niki Peppers`} description={t('murals.description')}>
  <section class="py-29 px-4 max-w-7xl mx-auto space-y-16">
    <!-- Hero Title Pages Section (componentized) -->
    <HeroTitlePages lang={lang} t={t} ns="murals" />

    <!-- Gallery component -->
    <GalleryPlus
      items={galleryItems}
      id="murals-gallery"
      showInitialCount={999}
      loadMoreLabel={t("murals.loadMore")}
    >
      <div slot="filters"></div>
    </GalleryPlus>

    <!-- Process -->
    <div class="bg-neutral-50 rounded-2xl p-8 md:p-12">
      <h2 class="text-3xl font-bold mb-8 text-center text-black">{t('murals.processTitle')}</h2>
      <div class="grid md:grid-cols-5 gap-6">
        <div class="text-center">
          <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
            1
          </div>
          <h3 class="font-bold mb-2 text-black">{t('murals.step1Title')}</h3>
          <p class="text-neutral-600 text-sm">{t('murals.step1Desc')}</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
            2
          </div>
          <h3 class="font-bold mb-2 text-black">{t('murals.step2Title')}</h3>
          <p class="text-neutral-600 text-sm">{t('murals.step2Desc')}</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
            3
          </div>
          <h3 class="font-bold mb-2 text-black">{t('murals.step3Title')}</h3>
          <p class="text-neutral-600 text-sm">{t('murals.step3Desc')}</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
            4
          </div>
          <h3 class="font-bold mb-2 text-black">{t('murals.step4Title')}</h3>
          <p class="text-neutral-600 text-sm">{t('murals.step4Desc')}</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
            5
          </div>
          <h3 class="font-bold mb-2 text-black">{t('murals.step5Title')}</h3>
          <p class="text-neutral-600 text-sm">{t('murals.step5Desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <CTASection lang={lang} t={t} ns="murals" />

  <CrossPromo lang={lang} />
</Layout>
