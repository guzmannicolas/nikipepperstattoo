---
import Layout from "../../layouts/Layout.astro";
import CrossPromo from "../../components/calltoaction/CrossPromo.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import HeroTitlePages from "../../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t('biography.title')} - ${t('home.title')}`} description={t('biography.description')}>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="biography" />

		<!-- Main Content -->
		<div class="grid md:grid-cols-2 gap-12 items-center mb-20">
			<div class="bg-neutral-100 rounded-xl h-96 flex items-center justify-center border-2 border-neutral-200">
				<p class="text-neutral-400">Profile photo here</p>
			</div>
			<div>
				<h2 class="text-3xl font-bold mb-6 text-black">{t('biography.greeting')}</h2>
				<p class="text-neutral-600 text-lg mb-4">
					{t('biography.bio1')}
				</p>
				<p class="text-neutral-600 text-lg mb-4">
					{t('biography.bio2')}
				</p>
				<p class="text-neutral-600 text-lg mb-4">
					{t('biography.bio3')}
				</p>
				<p class="text-neutral-600 text-lg">
					{t('biography.bio4')}
				</p>
			</div>
		</div>

		<!-- Skills Section -->
		<div class="mb-20">
			<h2 class="text-3xl font-bold text-center mb-12 text-black">{t('biography.specialtiesTitle')}</h2>
			<div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
				<div class="bg-white p-6 rounded-xl border-2 border-neutral-200 text-center">
					<div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
						<svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
						</svg>
					</div>
					<h3 class="font-bold text-xl mb-2 text-black">{t('biography.specialty1Title')}</h3>
				<p class="text-neutral-600">{t('biography.specialty1Desc')}</p>
			</div>
			<div class="bg-white p-6 rounded-xl border-2 border-neutral-200 text-center">
				<div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
				<h3 class="font-bold text-xl mb-2 text-black">{t('biography.specialty2Title')}</h3>
				<p class="text-neutral-600">{t('biography.specialty2Desc')}</p>
			</div>
			<div class="bg-white p-6 rounded-xl border-2 border-neutral-200 text-center">
				<div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
				<h3 class="font-bold text-xl mb-2 text-black">{t('biography.specialty3Title')}</h3>
				<p class="text-neutral-600">{t('biography.specialty3Desc')}</p>
			</div>
			<div class="bg-white p-6 rounded-xl border-2 border-neutral-200 text-center">
				<div class="w-16 h-16 bg-green-500/10 rounded-full flex items-center justify-center mx-auto mb-4">
					<svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
				</div>
				<h3 class="font-bold text-xl mb-2 text-black">{t('biography.specialty4Title')}</h3>
				<p class="text-neutral-600">{t('biography.specialty4Desc')}</p>
			</div>
			</div>
		</div>

		<!-- Values -->
		<div class="bg-neutral-50 rounded-2xl p-8 md:p-12">
			<h2 class="text-3xl font-bold mb-8 text-center text-black">{t('biography.philosophyTitle')}</h2>
			<div class="grid md:grid-cols-3 gap-8">
				<div>
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('biography.value1Icon')} {t('biography.value1Title')}</h3>
					<p class="text-neutral-600">
						{t('biography.value1Desc')}
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('biography.value2Icon')} {t('biography.value2Title')}</h3>
					<p class="text-neutral-600">
						{t('biography.value2Desc')}
					</p>
				</div>
				<div>
					<h3 class="text-xl font-bold mb-3 text-green-600">{t('biography.value3Icon')} {t('biography.value3Title')}</h3>
					<p class="text-neutral-600">
						{t('biography.value3Desc')}
					</p>
				</div>
			</div>
		</div>
	</section>

	<CrossPromo />

	<!-- CTA Section -->
	<section class="py-20 px-4 bg-white">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="text-3xl font-bold mb-4 text-black">{t('biography.ctaTitle')}</h2>
			<p class="text-neutral-600 mb-8 text-lg">
				{t('biography.ctaDescription')}
			</p>
			<a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="inline-block px-8 py-3 bg-black hover:bg-neutral-800 rounded-lg font-semibold transition-colors text-white">
				{t('biography.ctaButton')}
			</a>
		</div>
	</section>
</Layout>
