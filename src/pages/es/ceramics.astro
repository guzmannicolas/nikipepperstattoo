---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import ceramicsData from "../../data/ceramics.json";
// Import actual assets so Astro/Vite can process them
import cer1 from "../../assets/ceramics/Mateta Pisces - Back.avif";
import cer2 from "../../assets/ceramics/Mateta Pisces - Front.avif";
import cer3 from "../../assets/ceramics/Kisses pot.avif";
import cer4 from "../../assets/ceramics/Leaf mask.avif";
import cer5 from "../../assets/ceramics/Pop pot - Back.avif";
import cer6 from "../../assets/ceramics/Pop pot - Front.avif";
import cer7 from "../../assets/ceramics/Chrysanthemum bowl - Side view.avif";
import cer8 from "../../assets/ceramics/Chrysanthemum bowl - Inside view.avif";
import cer9 from "../../assets/ceramics/Pisces bowl - Inside view.avif";
import cer10 from "../../assets/ceramics/Pisces bowl - Side view.avif";
import cer11 from "../../assets/ceramics/Coral candle holder.avif";
const assetMap = {
	"Mateta Pisces - Back.avif": cer1,
	"Mateta Pisces - Front.avif": cer2,
	"Kisses pot.avif": cer3,
	"Leaf mask.avif": cer4,
	"Pop pot - Back.avif": cer5,
	"Pop pot - Front.avif": cer6,
	"Chrysanthemum bowl - Side view.avif": cer7,
	"Chrysanthemum bowl - Inside view.avif": cer8,
	"Pisces bowl - Inside view.avif": cer9,
	"Pisces bowl - Side view.avif": cer10,
	"Coral candle holder.avif": cer11,
};
import FilterButtons from "../../components/buttons/FilterButtons.astro";
import Gallery from "../../components/ui/Gallery.astro";
import CrossPromo from "../../components/CrossPromo.astro";
import AboutCeramicsSection from "../../components/sections/ceramics/AboutCeramicsSection.astro";
import CTASection from "../../components/calltoaction/CTASection.astro";
import HeroTitlePages from "../../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Resolve ceramic JSON image paths to imported assets so Astro can process them
const galleryItems = ceramicsData.items.map((item) => {
	const srcPath = item.images && item.images[0] ? item.images[0].path : "";
	const filename = srcPath ? srcPath.split("/").pop() : "";
	const has =
		filename && Object.prototype.hasOwnProperty.call(assetMap, filename);
	const image = has ? (assetMap as any)[filename] : srcPath;
	return {
		image,
		title: item.title.en,
		alt: item.images && item.images[0] ? item.images[0].alt || "" : "",
		categories: item.category,
	};
});
---

<Layout
	title={`${t("ceramics.title")} - Niki Peppers`}
	description={t("ceramics.description")}
>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="ceramics" />

		<!-- Unified Gallery component (replaces manual grid + lightbox) -->
		<Gallery
			items={galleryItems}
			id="ceramics-gallery"
			showInitialCount={6}
			loadMoreLabel={t("ceramics.loadMore")}
		>
			<div slot="filters">
				{
					(() => {
						const buttons = [
							{
								label: t("ceramics.filters.all"),
								value: "all",
								active: true,
							},
							{
								label: t("ceramics.filters.functional"),
								value: "functional",
							},
							{
								label: t("ceramics.filters.decorative"),
								value: "decorative",
							},
							{
								label: t("ceramics.filters.sculptural"),
								value: "sculptural",
							},
						];
						return <FilterButtons buttons={buttons} />;
					})()
				}
			</div>
		</Gallery>
	</section>

	<!-- About Ceramics Section (componentized) -->
	<AboutCeramicsSection t={t} />

	<!-- CTA Section (component) -->
	<CTASection lang={lang} t={t} ns="ceramics" />

	<CrossPromo lang={lang} />

	<style>
		/* Small helper: allow JS to toggle overlay visibility on touch devices */
		.meta {
			transition: opacity 0.2s ease;
		}
		.meta.visible {
			opacity: 1 !important;
		}
	</style>
</Layout>
