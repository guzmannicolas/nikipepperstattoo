---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`Niki Peppers - ${t('home.title')}`}>
	<!-- Hero + About Artist Section with Video Background -->
	<div class="relative bg-white overflow-hidden">
		<!-- Video Background for both sections -->
		<video autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover opacity-50 z-0" poster="/images/hero-poster.jpg">
			<source src="/videos/video-hero.webm" type="video/webm" />
			<source src="/videos/video-hero.mp4" type="video/mp4" />
		</video>

		<!-- Hero Section -->
		<section class="relative h-screen flex items-center justify-center">
			<div class="relative z-10 text-center px-4">
				<div class="mb-6 animate-fade-in-scale">
					<img 
						src="/images/home/titulo-header.png" 
						alt="Niki Peppers" 
						class="w-full max-w-2xl mx-auto h-auto"
					/>
				</div>
				<p class="text-xl md:text-2xl text-neutral-600 mb-8 max-w-2xl mx-auto font-light">
					{t('home.subtitle')}
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href={`/${lang === 'en' ? '' : lang + '/'}works`} class="px-8 py-3 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors">
						{t('home.viewWorks')}
					</a>
					<a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="px-8 py-3 bg-transparent border-2 border-black hover:bg-neutral-50 text-black rounded-lg font-semibold transition-colors">
						{t('home.bookConsultation')}
					</a>
				</div>
			</div>
		</section>

		<!-- About Artist Section -->
		<section class="relative py-24 px-4 z-10">
		<div class="max-w-6xl mx-auto">
			<div class="text-center max-w-4xl mx-auto">
				<h2 class="text-4xl md:text-6xl font-bold mb-6 text-black leading-tight">
					{t('home.aboutArtistTitle')}
				</h2>
				<p class="text-lg md:text-xl text-neutral-600 mb-10 leading-relaxed">
					{t('home.aboutArtistSubtitle')}
				</p>
				<a 
					href={`/${lang === 'en' ? '' : lang + '/'}biography`} 
					class="inline-block px-8 py-4 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors text-lg"
				>
					{t('home.aboutArtistButton')}
				</a>
			</div>
		</div>
	</section>
	</div>

	<!-- Styles Section -->
	<section class="py-20 px-4 max-w-7xl mx-auto">
		<h2 class="text-4xl font-bold text-center mb-12 text-black">{t('home.stylesTitle')}</h2>
		<div class="grid md:grid-cols-3 gap-8">
			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-2 text-black">{t('home.realism.title')}</h3>
				<p class="text-neutral-600">{t('home.realism.description')}</p>
			</div>
			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-2 text-black">{t('home.traditional.title')}</h3>
				<p class="text-neutral-600">{t('home.traditional.description')}</p>
			</div>
			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200 hover:border-green-400 transition-all hover:shadow-lg">
				<div class="w-12 h-12 bg-green-50 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-2 text-black">{t('home.fineline.title')}</h3>
				<p class="text-neutral-600">{t('home.fineline.description')}</p>
			</div>
		</div>
	</section>

	<!-- Newsletter Section -->
	<section class="py-20 px-4 bg-neutral-50 border-y border-neutral-200">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="text-3xl font-bold mb-4 text-black">{t('home.newsletterTitle')}</h2>
			<p class="text-neutral-600 mb-8">
				{t('home.newsletterDescription')}
			</p>
			<form class="flex flex-col sm:flex-row gap-4 max-w-md mx-auto" id="newsletter-form">
				<input
					type="email"
					placeholder={t('home.emailPlaceholder')}
					required
					class="flex-1 px-4 py-3 bg-white border-2 border-neutral-200 rounded-lg focus:outline-none focus:border-green-500 transition-colors text-black"
				/>
				<button
					type="submit"
					class="px-8 py-3 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors whitespace-nowrap"
				>
					{t('home.subscribe')}
				</button>
			</form>
			<p class="text-sm text-neutral-500 mt-4">
				{t('home.newsletterDisclaimer')}
			</p>
		</div>
	</section>

	<!-- About Preview -->
	<section class="py-20 px-4 max-w-7xl mx-auto">
		<div class="grid md:grid-cols-2 gap-12 items-center">
			<div>
				<h2 class="text-4xl font-bold mb-6 text-black">{t('home.aboutTitle')}</h2>
				<p class="text-neutral-600 text-lg mb-6">
					{t('home.aboutText1')}
				</p>
				<p class="text-neutral-600 text-lg mb-8">
					{t('home.aboutText2')}
				</p>
				<a href={`/${lang === 'en' ? '' : lang + '/'}biography`} class="inline-flex items-center text-green-600 hover:text-green-500 font-semibold">
					{t('home.learnMore')}
					<svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
					</svg>
				</a>
			</div>
			<div class="bg-neutral-100 rounded-xl h-96 flex items-center justify-center border-2 border-neutral-200">
				<p class="text-neutral-600">{t('home.photoPlaceholder')}</p>
			</div>
		</div>
	</section>
</Layout>
