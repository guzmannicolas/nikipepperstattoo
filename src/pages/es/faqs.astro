---
import Layout from "../../layouts/Layout.astro";
import CrossPromo from "../../components/calltoaction/CrossPromo.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import FilterButtons from "../../components/buttons/FilterButtons.astro";
import FAQList from "../../components/sections/faqs/FAQList.astro";
import CTASection from "../../components/calltoaction/CTASection.astro";
import HeroTitlePages from "../../components/sections/HeroTitlePages.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Faq = {
  category: "tattoos" | "ceramics" | "artworks" | "orders" | "general";
  question: string;
  answer: string;
};

const faqs: Faq[] = [
  // Tattoos
  {
    category: "tattoos",
    question: t("faqs.questions.tattoos.book"),
    answer: t("faqs.answers.tattoos.book"),
  },
  {
    category: "tattoos",
    question: t("faqs.questions.tattoos.pain"),
    answer: t("faqs.answers.tattoos.pain"),
  },
  {
    category: "tattoos",
    question: t("faqs.questions.tattoos.prepare"),
    answer: t("faqs.answers.tattoos.prepare"),
  },
  // Ceramics
  {
    category: "ceramics",
    question: t("faqs.questions.ceramics.custom"),
    answer: t("faqs.answers.ceramics.custom"),
  },
  {
    category: "ceramics",
    question: t("faqs.questions.ceramics.timeline"),
    answer: t("faqs.answers.ceramics.timeline"),
  },
  {
    category: "ceramics",
    question: t("faqs.questions.ceramics.safe"),
    answer: t("faqs.answers.ceramics.safe"),
  },
  // Artworks
  {
    category: "artworks",
    question: t("faqs.questions.artworks.purchase"),
    answer: t("faqs.answers.artworks.purchase"),
  },
  {
    category: "artworks",
    question: t("faqs.questions.artworks.prints"),
    answer: t("faqs.answers.artworks.prints"),
  },
  {
    category: "artworks",
    question: t("faqs.questions.artworks.mediums"),
    answer: t("faqs.answers.artworks.mediums"),
  },
  // Orders / Commissions
  {
    category: "orders",
    question: t("faqs.questions.orders.process"),
    answer: t("faqs.answers.orders.process"),
  },
  {
    category: "orders",
    question: t("faqs.questions.orders.payments"),
    answer: t("faqs.answers.orders.payments"),
  },
  // General
  {
    category: "general",
    question: t("faqs.questions.general.location"),
    answer: t("faqs.answers.general.location"),
  },
  {
    category: "general",
    question: t("faqs.questions.general.reply"),
    answer: t("faqs.answers.general.reply"),
  },
];

// Prepare filter buttons
const filterButtons = [
  { label: "All", value: "all", active: true },
  { label: t("faqs.categories.tattoos"), value: "tattoos" },
  { label: t("faqs.categories.ceramics"), value: "ceramics" },
  { label: t("faqs.categories.artworks"), value: "artworks" },
  { label: t("faqs.categories.orders"), value: "orders" },
  { label: t("faqs.categories.general"), value: "general" },
];

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<Layout
  title={`${t("faqs.title")} - Niki Peppers`}
  description={t("faqs.description")}
  pageSchema={faqPageSchema}
>
  <section class="py-29 px-4 max-w-5xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="faqs" />

    <!-- Category Filters -->
    <FilterButtons buttons={filterButtons} />

    <!-- FAQ List -->
    <FAQList faqs={faqs} />
  </section>

  <CrossPromo />

  <!-- CTA Section -->
  <CTASection lang={lang} t={t} ns="faqs" />
</Layout>
