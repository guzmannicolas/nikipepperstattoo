---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

type Faq = { category: 'tattoos' | 'ceramics' | 'artworks' | 'orders' | 'general'; question: string; answer: string };

const faqs: Faq[] = [
  // Tatuajes
  { category: 'tattoos', question: '¿Cómo reservo un tatuaje?', answer: 'Enviá tu idea por el formulario de contacto con referencias, tamaño y zona. Te respondo con disponibilidad, un estimado y los pasos a seguir. Puede requerirse una seña para reservar.' },
  { category: 'tattoos', question: '¿Duele?', answer: 'La sensibilidad depende de cada persona y de la zona. Trabajo con cuidado, hago pausas cuando es necesario y te doy indicaciones de cuidado para una buena cicatrización.' },
  { category: 'tattoos', question: '¿Cómo me preparo para la sesión?', answer: 'Descansá bien, hidratate y comé antes de venir. Evitá alcohol y anticoagulantes 24 hs antes. Usá ropa cómoda que deje acceder a la zona.' },

  // Cerámica
  { category: 'ceramics', question: '¿Hacés piezas de cerámica por pedido?', answer: 'Sí. Contame tu idea, función, medidas y terminación deseada. Te confirmo viabilidad y un tiempo estimado antes de empezar.' },
  { category: 'ceramics', question: '¿Cuánto tarda un encargo de cerámica?', answer: 'Generalmente entre 3 y 6 semanas según complejidad, tiempos de secado, esmaltado y horneadas disponibles.' },
  { category: 'ceramics', question: '¿Son aptas lavavajillas/microondas?', answer: 'La mayoría de las piezas funcionales son aptas salvo que se indique lo contrario. Las piezas escultóricas son solo decorativas.' },

  // Obras
  { category: 'artworks', question: '¿Vendés pinturas originales?', answer: 'Sí, hay obras disponibles. Si te interesa una pieza o una comisión, escribime para ver disponibilidad y precios.' },
  { category: 'artworks', question: '¿Hacés impresiones (prints)?', answer: 'Puede haber ediciones limitadas de algunas obras. Consultá por ediciones y tamaños disponibles.' },
  { category: 'artworks', question: '¿Qué técnicas usás?', answer: 'Principalmente óleo y acrílico sobre lienzo, acuarela sobre papel y técnica mixta según la serie.' },

  // Pedidos / Comisiones
  { category: 'orders', question: '¿Cómo es el proceso de una comisión?', answer: 'Conversamos tu idea, tiempos, presupuesto y referencias. Te propongo un concepto y un presupuesto. Con una seña se inicia el proyecto; el saldo se paga al entregar.' },
  { category: 'orders', question: '¿Qué medios de pago aceptás?', answer: 'Métodos digitales comunes y transferencias. Los detalles se comparten durante la reserva.' },

  // General
  { category: 'general', question: '¿Dónde estás?', answer: 'Trabajo en Buenos Aires, Argentina. Algunos proyectos pueden coordinarse de forma remota.' },
  { category: 'general', question: '¿En cuánto tiempo respondés?', answer: 'Suelo responder dentro de 1 a 3 días hábiles. Si es urgente, mencionarlo en el mensaje ayuda.' },
];
---

<Layout title={`${t('faqs.title')} - Niki Peppers`} description={t('faqs.description')}>
  <section class="py-20 px-4 max-w-5xl mx-auto">
    <div class="text-center mb-10">
      <h1 class="text-5xl font-bold mb-4 text-black">{t('faqs.title')}</h1>
      <p class="text-neutral-600 text-lg max-w-2xl mx-auto">{t('faqs.description')}</p>
    </div>

    <!-- Filtros por categoría -->
    <div class="flex flex-wrap justify-center gap-3 mb-10">
      <button class="faq-filter active px-4 py-2 rounded-full bg-green-500 text-white font-semibold" data-category="all">Todas</button>
      <button class="faq-filter px-4 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black" data-category="tattoos">{t('faqs.categories.tattoos')}</button>
      <button class="faq-filter px-4 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black" data-category="ceramics">{t('faqs.categories.ceramics')}</button>
      <button class="faq-filter px-4 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black" data-category="artworks">{t('faqs.categories.artworks')}</button>
      <button class="faq-filter px-4 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black" data-category="orders">{t('faqs.categories.orders')}</button>
      <button class="faq-filter px-4 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 text-black" data-category="general">{t('faqs.categories.general')}</button>
    </div>

    <!-- Lista de FAQs -->
    <div class="space-y-4">
      {faqs.map((item, idx) => (
        <details class="faq-item group bg-white border border-neutral-200 rounded-xl" data-category={item.category} open={idx === 0}>
          <summary class="cursor-pointer list-none px-5 py-4 flex items-start justify-between gap-4">
            <span class="font-semibold text-black">{item.question}</span>
            <svg class="w-5 h-5 text-neutral-500 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
          </summary>
          <div class="px-5 pb-5 text-neutral-700 leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>

    <!-- CTA de contacto -->
    <div class="text-center mt-14">
      <p class="text-neutral-600 mb-4">{t('faqs.contactCta')}</p>
      <a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="inline-block px-8 py-3 bg-black hover:bg-neutral-800 text-white rounded-lg font-semibold transition-colors">{t('faqs.contactButton')}</a>
    </div>
  </section>

  <script>
    const faqFilters = document.querySelectorAll('.faq-filter');
    const faqItems = document.querySelectorAll('.faq-item');

    faqFilters.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');

        // Estado activo
        faqFilters.forEach(b => b.classList.remove('active', 'bg-green-500', 'text-white'));
        faqFilters.forEach(b => b.classList.add('bg-white', 'border-2', 'border-neutral-200', 'text-black'));
        btn.classList.add('active', 'bg-green-500', 'text-white');
        btn.classList.remove('bg-white', 'border-2', 'border-neutral-200', 'text-black');

        // Filtrar items
        faqItems.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (category === 'all' || itemCategory === category) {
            item.classList.remove('hidden');
          } else {
            item.classList.add('hidden');
          }
        });
      });
    });
  </script>
</Layout>
