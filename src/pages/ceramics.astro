---
import Layout from "../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import ceramicsData from "../data/ceramics.json";
import FilterButtons from "../components/buttons/FilterButtons.astro";
import Gallery from "../components/ui/Gallery.astro";
import CrossPromo from "../components/calltoaction/CrossPromo.astro";
import AboutCeramicsSection from "../components/sections/ceramics/AboutCeramicsSection.astro";
import CTASection from "../components/calltoaction/CTASection.astro";
import HeroTitlePages from "../components/sections/HeroTitlePages.astro";

const ceramicImages = import.meta.glob(
	"/src/assets/ceramics/*.{avif,jpg,jpeg,png}",
	{ eager: true }
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Resolve ceramic JSON image paths to imported assets so Astro can process them
const galleryItems = ceramicsData.items.map((item) => {
	const srcPath = item.images && item.images[0] ? item.images[0].path : "";
	const imageModule = (ceramicImages as any)[srcPath];
	const image = imageModule ? imageModule.default : srcPath;
	const localizedTitle = item.title?.[lang] || item.title?.en || "";
	const localizedCategories =
		lang === "es"
			? item.category_es || item.category || ""
			: item.category || "";
	return {
		image,
		title: localizedTitle,
		alt: item.images && item.images[0] ? item.images[0].alt || "" : "",
		categories: item.category,
		displayCategories: localizedCategories,
	};
});
---

<Layout
	title={`${t("ceramics.title")} - Niki Peppers`}
	description={t("ceramics.description")}
>
	<section class="py-29 px-4 max-w-7xl mx-auto">
		<!-- Hero Title Pages Section (componentized) -->
		<HeroTitlePages lang={lang} t={t} ns="ceramics" />

		<!-- Unified Gallery component (replaces manual grid + lightbox) -->
		<Gallery
			items={galleryItems}
			id="ceramics-gallery"
			showInitialCount={6}
			loadMoreLabel={t("ceramics.loadMore")}
		>
			<div slot="filters">
				{
					(() => {
						const buttons = [
							{
								label: t("ceramics.filters.all"),
								value: "all",
								active: true,
							},
							{
								label: t("ceramics.filters.functional"),
								value: "functional",
							},
							{
								label: t("ceramics.filters.decorative"),
								value: "decorative",
							},
							{
								label: t("ceramics.filters.sculptural"),
								value: "sculptural",
							},
						];
						return <FilterButtons buttons={buttons} />;
					})()
				}
			</div>
		</Gallery>
	</section>

	<!-- About Ceramics Section (componentized) -->
	<AboutCeramicsSection t={t} />

	<!-- CTA Section (component) -->
	<CTASection lang={lang} t={t} ns="ceramics" />

	<CrossPromo lang={lang} />

	<style>
		/* Small helper: allow JS to toggle overlay visibility on touch devices */
		.meta {
			transition: opacity 0.2s ease;
		}
		.meta.visible {
			opacity: 1 !important;
		}
	</style>
</Layout>
