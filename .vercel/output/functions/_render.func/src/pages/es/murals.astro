---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t('murals.title')} - Niki Peppers`} description={t('murals.description')}>
	<section class="py-20 px-4 max-w-7xl mx-auto">
		<div class="text-center mb-16">
			<h1 class="text-5xl font-bold mb-4 text-black">{t('murals.title')}</h1>
			<p class="text-neutral-600 text-lg max-w-2xl mx-auto">
				{t('murals.description')}
			</p>
		</div>

		<!-- Filter Buttons -->
		<div class="flex flex-wrap justify-center gap-4 mb-12">
			<button class="filter-btn active px-6 py-2 rounded-full bg-green-500 text-white font-semibold" data-filter="all">
				{t('murals.filters.all')}
			</button>
			<button class="filter-btn px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 font-semibold transition-colors text-black" data-filter="residential">
				{t('murals.filters.residential')}
			</button>
			<button class="filter-btn px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 font-semibold transition-colors text-black" data-filter="commercial">
				{t('murals.filters.commercial')}
			</button>
			<button class="filter-btn px-6 py-2 rounded-full bg-white border-2 border-neutral-200 hover:border-green-400 font-semibold transition-colors text-black" data-filter="public">
				{t('murals.filters.public')}
			</button>
		</div>

		<!-- Gallery Grid - Larger format for murals -->
		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
			{Array.from({ length: 6 }).map((_, i) => (
				<div class="gallery-item group relative aspect-video bg-neutral-100 rounded-xl overflow-hidden border-2 border-neutral-200 hover:border-green-400 hover:shadow-lg transition-all cursor-pointer" data-category={['residential', 'commercial', 'public'][i % 3]}>
					<div class="w-full h-full flex items-center justify-center text-neutral-400">
						<p>Mural Project #{i + 1}</p>
					</div>
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-6">
						<div>
							<h3 class="text-2xl font-bold mb-2 text-white">Large Scale Mural</h3>
							<p class="text-neutral-200">
								{['Residential Space', 'Commercial Building', 'Public Installation'][i % 3]} • {15 + i * 5}m²
							</p>
						</div>
					</div>
				</div>
			))}
		</div>

		<!-- Load More -->
		<div class="text-center mb-20">
			<button class="px-8 py-3 bg-transparent border-2 border-black hover:bg-neutral-100 rounded-lg font-semibold transition-colors text-black">
				{t('murals.loadMore')}
			</button>
		</div>

		<!-- Services Section -->
		<div class="grid md:grid-cols-3 gap-8 mb-20">
			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200">
				<div class="w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-3 text-black">{t('murals.residentialTitle')}</h3>
				<p class="text-neutral-600">
					{t('murals.residentialDesc')}
				</p>
			</div>

			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200">
				<div class="w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-3 text-black">{t('murals.commercialTitle')}</h3>
				<p class="text-neutral-600">
					{t('murals.commercialDesc')}
				</p>
			</div>

			<div class="bg-white p-8 rounded-xl border-2 border-neutral-200">
				<div class="w-12 h-12 bg-green-500/10 rounded-lg flex items-center justify-center mb-4">
					<svg class="w-6 h-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
					</svg>
				</div>
				<h3 class="text-xl font-bold mb-3 text-black">{t('murals.publicTitle')}</h3>
				<p class="text-neutral-600">
					{t('murals.publicDesc')}
				</p>
			</div>
		</div>

		<!-- Process -->
		<div class="bg-neutral-50 rounded-2xl p-8 md:p-12">
			<h2 class="text-3xl font-bold mb-8 text-center text-black">{t('murals.processTitle')}</h2>
			<div class="grid md:grid-cols-5 gap-6">
				<div class="text-center">
					<div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
						1
					</div>
					<h3 class="font-bold mb-2 text-black">{t('murals.step1Title')}</h3>
					<p class="text-neutral-600 text-sm">{t('murals.step1Desc')}</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
						2
					</div>
					<h3 class="font-bold mb-2 text-black">{t('murals.step2Title')}</h3>
					<p class="text-neutral-600 text-sm">{t('murals.step2Desc')}</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
						3
					</div>
					<h3 class="font-bold mb-2 text-black">{t('murals.step3Title')}</h3>
					<p class="text-neutral-600 text-sm">{t('murals.step3Desc')}</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
						4
					</div>
					<h3 class="font-bold mb-2 text-black">{t('murals.step4Title')}</h3>
					<p class="text-neutral-600 text-sm">{t('murals.step4Desc')}</p>
				</div>
				<div class="text-center">
					<div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold text-white">
						5
					</div>
					<h3 class="font-bold mb-2 text-black">{t('murals.step5Title')}</h3>
					<p class="text-neutral-600 text-sm">{t('murals.step5Desc')}</p>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-20 px-4 bg-neutral-50">
		<div class="max-w-3xl mx-auto text-center">
			<h2 class="text-3xl font-bold mb-4 text-black">{t('murals.ctaTitle')}</h2>
			<p class="text-neutral-600 mb-8 text-lg">
				{t('murals.ctaDescription')}
			</p>
			<a href={`/${lang === 'en' ? '' : lang + '/'}contact`} class="inline-block px-8 py-3 bg-black hover:bg-neutral-800 rounded-lg font-semibold transition-colors text-white">
				{t('murals.ctaButton')}
			</a>
		</div>
	</section>

	<script>
		const filterBtns = document.querySelectorAll('.filter-btn');
		const galleryItems = document.querySelectorAll('.gallery-item');

		filterBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				const filter = btn.getAttribute('data-filter');
				
				// Update active button
				filterBtns.forEach(b => {
					b.classList.remove('active', 'bg-green-500', 'text-white');
					b.classList.add('bg-white', 'border-2', 'border-neutral-200', 'text-black');
				});
				btn.classList.add('active', 'bg-green-500', 'text-white');
				btn.classList.remove('bg-white', 'border-2', 'border-neutral-200', 'text-black');

				// Filter items
				galleryItems.forEach(item => {
					if (filter === 'all' || item.getAttribute('data-category') === filter) {
						item.classList.remove('hidden');
					} else {
						item.classList.add('hidden');
					}
				});
			});
		});
	</script>
</Layout>
