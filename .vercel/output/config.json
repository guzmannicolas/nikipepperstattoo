{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/biography/?$",
			"dest": "_render"
		},
		{
			"src": "^/ceramics/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/biography/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/ceramics/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/faqs/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/murals/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/tattoos/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/works/?$",
			"dest": "_render"
		},
		{
			"src": "^/es/?$",
			"dest": "_render"
		},
		{
			"src": "^/faqs/?$",
			"dest": "_render"
		},
		{
			"src": "^/murals/?$",
			"dest": "_render"
		},
		{
			"src": "^/tattoos/?$",
			"dest": "_render"
		},
		{
			"src": "^/works/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}