# CMS access for scripts/fetch-cms.mjs (runs before `pnpm dev` and `pnpm build`).
# Same values as the Vercel environment variables.
DIRECTUS_URL=https://cms.nicoguzmandev.com
DIRECTUS_TOKEN=

# Contact form (optional, for local testing only). Defaults: <DIRECTUS_URL>/contact-form/nikipeppers.com
# and the real Turnstile site key. Production needs neither.
# CONTACT_FORM_URL=
# PUBLIC_TURNSTILE_SITE_KEY=
